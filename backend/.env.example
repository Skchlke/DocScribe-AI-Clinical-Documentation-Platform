# Copy this file to .env and adjust as needed.

# SQLAlchemy database URL.
DATABASE_URL=sqlite:///./docscribe.db

# Comma-separated list of allowed origins for CORS, or "*" for all (local dev default).
# e.g. CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=*

# Directory where uploaded patient photos and appointment documents are stored.
UPLOAD_DIR=uploads
